{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickapp-kit.dev/v1/runtime-metadata.schema.json",
  "title": "QuickApp Kit V1 Runtime Metadata",
  "type": "object",
  "required": ["schemaVersion", "packageFormat", "runtimeAbi", "irVersion", "jsModuleAbi", "packageId", "toolkit", "buildMode", "entryRoute", "app", "sharedModules", "pages", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageFormat": { "const": "quickapp-kit-rpk-v1" },
    "runtimeAbi": { "const": "quickapp-kit-runtime-v1" },
    "irVersion": { "const": 1 },
    "jsModuleAbi": { "const": "quickapp-kit-app-module-v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "toolkit": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "quickapp-toolkit" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "buildMode": { "enum": ["debug", "release"] },
    "entryRoute": { "$ref": "#/$defs/route" },
    "app": { "$ref": "#/$defs/module" },
    "sharedModules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "route": { "type": "string", "pattern": "^/.+$" },
    "logicalPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["path", "mediaType", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/logicalPath" },
        "mediaType": { "enum": ["application/javascript", "application/json", "application/octet-stream", "image/png", "image/jpeg", "video/mp4", "video/webm"] },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "resourceId": { "$ref": "#/$defs/logicalPath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mediaType": { "enum": ["video/mp4", "video/webm"] } } },
          "then": {
            "required": ["resourceId"],
            "properties": {
              "resourceId": { "$ref": "#/$defs/logicalPath" }
            }
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "required": ["moduleId", "dependencies", "bundle"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "bundle": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["route", "manifestRoute", "component", "moduleId", "dependencies", "templateId", "bundle", "pageIr"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "manifestRoute": { "type": "string", "pattern": "^[^/].+$" },
        "component": { "type": "string", "minLength": 1 },
        "moduleId": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "templateId": { "type": "string", "minLength": 1 },
        "bundle": { "$ref": "#/$defs/artifact" },
        "pageIr": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
