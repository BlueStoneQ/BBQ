{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickapp-kit.dev/v1/host-component.schema.json",
  "title": "QuickApp Kit V1 Canonical Host Node",
  "oneOf": [
    { "$ref": "#/$defs/view" },
    { "$ref": "#/$defs/text" },
    { "$ref": "#/$defs/button" },
    { "$ref": "#/$defs/image" },
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/switch" }
    ,{ "$ref": "#/$defs/slider" }
    ,{ "$ref": "#/$defs/picker" }
    ,{ "$ref": "#/$defs/list" }
    ,{ "$ref": "#/$defs/scroll" }
    ,{ "$ref": "#/$defs/video" }
    ,{ "$ref": "#/$defs/tabs" }
  ],
  "$defs": {
    "sizeLength": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["logical-px", "percent"] }
      },
      "additionalProperties": false
    },
    "offsetLength": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["logical-px", "percent"] }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/$defs/sizeLength" },
        "height": { "$ref": "#/$defs/sizeLength" },
        "marginTop": { "$ref": "#/$defs/offsetLength" },
        "marginRight": { "$ref": "#/$defs/offsetLength" },
        "marginBottom": { "$ref": "#/$defs/offsetLength" },
        "marginLeft": { "$ref": "#/$defs/offsetLength" },
        "paddingTop": { "$ref": "#/$defs/sizeLength" },
        "paddingRight": { "$ref": "#/$defs/sizeLength" },
        "paddingBottom": { "$ref": "#/$defs/sizeLength" },
        "paddingLeft": { "$ref": "#/$defs/sizeLength" },
        "flexDirection": { "enum": ["row", "column"] },
        "justifyContent": { "enum": ["flex-start", "center", "flex-end", "space-between"] },
        "alignItems": { "enum": ["flex-start", "center", "flex-end", "stretch"] },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
        "borderRadius": { "type": "number", "minimum": 0 },
        "fontSize": { "type": "number", "minimum": 0 },
        "textAlign": { "enum": ["left", "center", "right"] }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "View" },
        "props": { "type": "object", "maxProperties": 0 },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Text" },
        "props": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "button": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Button" },
        "props": {
          "type": "object",
          "required": ["text", "enabled"],
          "properties": {
            "text": { "type": "string" },
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Image" },
        "props": {
          "type": "object",
          "required": ["src"],
          "properties": {
            "src": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$" }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Input" },
        "props": {
          "type": "object",
          "required": ["value", "enabled"],
          "properties": {
            "value": { "type": "string" },
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "switch": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Switch" },
        "props": {
          "type": "object",
          "required": ["checked", "enabled"],
          "properties": { "checked": { "type": "boolean" }, "enabled": { "type": "boolean" } },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "slider": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Slider" },
        "props": {
          "type": "object",
          "required": ["min", "max", "step", "value", "enabled"],
          "properties": {
            "min": { "type": "number" }, "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "value": { "type": "number" }, "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "picker": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Picker" },
        "props": {
          "type": "object",
          "required": ["mode", "range", "selected"],
          "properties": {
            "mode": { "const": "text" }, "range": { "type": "string", "minLength": 1 },
            "selected": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": { "type": { "const": "List" }, "props": { "type": "object", "maxProperties": 0 }, "style": { "$ref": "#/$defs/style" } },
      "additionalProperties": false
    },
    "scroll": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": { "type": { "const": "Scroll" }, "props": { "type": "object", "maxProperties": 0 }, "style": { "$ref": "#/$defs/style" } },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Video" },
        "props": {
          "type": "object",
          "required": ["src", "poster", "autoplay", "controls", "muted"],
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "poster": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$" }] },
            "autoplay": { "type": "boolean" },
            "controls": { "type": "boolean" },
            "muted": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "tabs": {
      "type": "object",
      "required": ["type", "props", "style"],
      "properties": {
        "type": { "const": "Tabs" },
        "props": {
          "type": "object",
          "required": ["items", "selected"],
          "properties": {
            "items": { "type": "string", "minLength": 1 },
            "selected": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    }
  }
}
